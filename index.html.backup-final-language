<!-- =========================================================
     THRESHOLD SAFETY HANDLER
     
     This is deliberately AFTER app.js.
     It guarantees that SKIP INTRO and language switching
     remain clickable even if another script initialization
     changes the threshold state.
========================================================= -->

<script>

(function(){

  function ready(){

    const threshold =
      document.getElementById('threshold');

    const skip =
      document.getElementById('skipThreshold');

    const language =
      document.getElementById('thresholdLangToggle');


    /* =====================================================
       SKIP INTRO
    ====================================================== */

    if(skip && threshold){

      skip.onclick = function(){

        threshold.classList.add('leaving');

        threshold.setAttribute(
          'aria-hidden',
          'true'
        );

        document.body.classList.remove(
          'portal-lock'
        );

        setTimeout(function(){

          threshold.style.display =
            'none';

        }, 850);

      };

    }


    /* =====================================================
       LANGUAGE
       
       app.js already owns the language state.
       We only provide a safe fallback if the normal
       listener was not attached.
    ====================================================== */

    if(language){

      language.setAttribute(
        'aria-label',
        'Switch between English and Slovenian'
      );

    }

  }


  if(
    document.readyState === 'loading'
  ){

    document.addEventListener(
      'DOMContentLoaded',
      ready,
      {
        once:true
      }
    );

  }else{

    ready();

  }

})();

</script>


